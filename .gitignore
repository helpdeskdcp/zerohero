backend/.env
backend/venv/
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
__pycache__/
*.pyc
.DS_Store

# runtime / job artefacts
backend/data/*.log
*.zip
.claude/
.aider*

# top-level runtime data dir (live DB + master cache, never committed)
/data/
# instrument master cache (~35MB, refetched on demand)
backend/data/instrument_master.json
# session monitors / wake scripts / jsonl written at runtime
backend/data/*.sh
backend/data/*.jsonl
backend/data/autoscalp_session_*.md
backend/data/ngcrude_session_report.md
# cron watcher runtime state (per-subgroup alert-once tracking)
backend/data/calibration_subgroups_state.json

# H1/H7 shadow-mode append-only event log (runtime artifact, regenerated on demand)
backend/data/orderflow_h1h7_shadow.csv

# Kaggle raw downloads: large + license not for redistribution. Manifest is tracked; data is local-only.
backend/data/historical/kaggle/**
!backend/data/historical/kaggle/
!backend/data/historical/kaggle/MANIFEST.json
!backend/data/historical/kaggle/inventory.csv
# H1/H7 perf eval auto-generated artifacts
backend/data/orderflow_h1h7_performance_auto.csv
backend/data/orderflow_h1h7_perf_cron_report.txt
# H1/H7 + spike research on option premium -- per-event CSV artifacts (regenerated on demand)
backend/data/orderflow_h1h7_spike_options.csv
backend/data/orderflow_spike_options_legs.csv
backend/data/orderflow_l2_imbalance_probe.csv

# Upstox expired-instruments research store (raw API responses + normalized DB): local only
backend/data/historical/upstox/

# L2 SnapQuote capture store (append-only research DB + WAL): local only, regenerated by capture
backend/data/l2_capture.db
backend/data/l2_capture.db-wal
backend/data/l2_capture.db-shm
