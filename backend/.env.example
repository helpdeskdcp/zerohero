# Copy to .env and fill in. Never commit the real .env to git.

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNALS_CHANNEL_ID=

# --- Angel One SmartAPI ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- App ---
CHANAKYA_DB_PATH=./data/chanakya.db

# Optional: if set, every /api/* call (except /api/health) and the /ws upgrade
# must present it as `Authorization: Bearer <token>` or `?token=<token>`.
# Leave blank for an open dashboard (current default behaviour).
CHANAKYA_API_TOKEN=

# Browser Basic Authentication (defaults: admin / admin@1234; change in production)
CHANAKYA_ADMIN_USERNAME=admin
CHANAKYA_ADMIN_PASSWORD=admin@1234

# --- Live execution (OFF unless every safeguard below is configured) ---
# Keep these only on the server. The confirmation value is never stored in
# SQLite or returned by the API. LIVE also requires execution_enabled=true in
# the runner config and a configured CHANAKYA_API_TOKEN.
CHANAKYA_ALLOW_LIVE=0
CHANAKYA_LIVE_CONFIRM_TOKEN=

# --- Groq AI (shadow-mode behavior engine, app/ai/groq_client.py. Optional --
# the deterministic trading engine works identically with these unset; the
# AI layer just reports CONFIG_REQUIRED and never runs. Never commit a real
# key. Free tier, no credit card: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=
# GROQ_FALLBACK_MODELS=                                     # comma-separated
# GROQ_BASE_URL=https://api.groq.com/openai/v1              # default shown, override only if needed
# GROQ_TIMEOUT_SEC=8.0
# GROQ_MAX_RETRIES=1

# --- Dhan broker integration (app/dhan_client.py App-based OAuth + optional
# real-time orderflow feed, app/connectors/dhan_ws.py + app/engines/orderflow_engine.py) ---
DHAN_APP_ID=
DHAN_APP_SECRET=
DHAN_CLIENT_ID=
# DHAN_POSTBACK_SECRET=              # long random token; part of the postback URL path, never guessable
# (the live access token itself is never in .env -- it's stored in the DB by
# the OAuth consent flow, app/dhan_client.py, and read via get_access_token())
# DHAN_ORDERFLOW_ENABLED=0           # 1 to start the live WS orderflow feed (OFF by default)
# DHAN_ORDERFLOW_AUTO_SYMBOLS=       # "NIFTY,BANKNIFTY" -- front-month future + ATM CE/PE, re-resolved daily
# DHAN_ORDERFLOW_INSTRUMENTS=        # "MCX_COMM:570750" -- extra explicit exchange_segment:security_id pairs, always included

# --- Optional overrides (all have safe code defaults; leave unset in normal use) ---
# ANGEL_MASTER_CACHE=/tmp/angelone_instrument_master.json   # SDK instrument-master cache path
# CHANAKYA_INSTRUMENT_MASTER=./data/instrument_master.json  # app-side instrument-master cache path
# CHANAKYA_MARKET_WINDOWS=                                  # JSON override for NSE/MCX/BSE session windows
# CHANAKYA_MARKET_HOLIDAYS=./data/market_holidays.json      # JSON list of holiday dates
# CHANAKYA_MAX_DATA_AGE_SEC=                                # candle-staleness threshold (default in market_calendar)
# OI_HISTORY_DB=                                            # separate OI-history sqlite path (legacy OI module)
# CHANAKYA_ENV_FILE=./.env                                  # dotenv path hint for `python -m app.mcp_server` only
