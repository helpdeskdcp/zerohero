{
  "package_schema": "validation-evidence-checklist/v1",
  "scope": "Track A checklist, NOT a provider-calendar manifest or production data",
  "prepared_on": "2026-10-02",
  "external_requests_made": false,
  "provider_calendar_schema_reviewed": "provider-calendar/v1",
  "production_calendar_versions": [],
  "requirements": {
    "HISTORICAL_UNIVERSE": "Declare requested as-of coverage [start,end) first (owner has not specified a window). Obtain the complete provider-listed eligible expiry set at every T, including maturities beyond end for NEXT; include additions, withdrawals and corrections. Do not derive a weekday/monthly list.",
    "TRADING_CALENDAR": "Archive official venue/segment trading dates, holidays, special sessions, emergency closures and dated contract-rule changes. Observed candle days or another exchange holiday list are insufficient.",
    "PUBLICATION_LISTING": "Retain original provider response/master/document bytes, source locator, capture/publication timestamps with timezone, each contract listing/delisting timestamp, effective interval, version, completeness proof, and SHA-256. Publication by T must be proved independently of a later download.",
    "EXPIRY_CUTOFF": "Obtain official last-trading date and exact time/timezone for each option contract, including holiday shifts/amendments. Do not assume 15:30, end-of-day, or futures expiry minus a business-day count.",
    "DHAN_IDENTITY": "Archive Dhan instrument/underlying security IDs and segment mapping for the historical interval and original full expiry-list responses. Current successful live lists cannot establish past availability.",
    "ANGEL_IDENTITY": "Archive AngelOne instrument master versions with token, name, instrumenttype, exchange segment, option expiry and publication/listing evidence. An individual captured option subset is not a complete calendar.",
    "MCX_UNDERLYING": "For each main/mini product separately, prove the option-to-underlying-future mapping, dated futures security/token IDs and option cutoff. A futures expiry or main-contract calendar alone is insufficient for the option/mini.",
    "INDEPENDENT_REVIEW": "An independent reviewer must compare every normalized field and completeness/temporal claim to retained source bytes; record reviewer, review date, locator, hashes and signed/traceable disposition. Never mark VERIFIED based on code comments, schema validity or synthetic tests."
  },
