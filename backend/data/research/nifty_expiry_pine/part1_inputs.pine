i_needResp = input.bool(true, "Zone must be price-confirmed (respected) before its break counts", group=G3,
     tooltip="The largest-OI strike is NOT assumed to be the strongest. A zone only counts as 'confirmed' after price has tested it and closed back on the respecting side.")
i_minRespect = input.int(1, "Minimum respected tests for 'confirmed'", minval=0, maxval=5, group=G3)
i_minZoneW   = input.float(0.35, "Minimum zone weight to trade a break", minval=0, step=0.05, group=G3)

G4 = "04 Gap intelligence (ATR-normalised, daily ATR tracked from the chart's own sessions)"
i_flatThr = input.float(0.15, "Flat open if |gap| < x daily ATR", minval=0, step=0.01, group=G4)
i_excThr  = input.float(1.00, "Exceptional gap if |gap| >= x daily ATR", minval=0.2, step=0.05, group=G4)
i_fillFrac = input.float(0.35, "Gap-fill fraction that counts as a reversal", minval=0.05, maxval=1, step=0.05, group=G4)

G5 = "05 Opening / first completed candle"
i_orMin       = input.int(15, "Opening range minutes", minval=5, maxval=60, group=G5)
i_strongBody  = input.float(0.55, "Strong candle: body / range >=", minval=0.1, maxval=1, step=0.05, group=G5)
i_locHi       = input.float(0.65, "Close location (0..1) bullish if >=", minval=0.5, maxval=1, step=0.05, group=G5)
i_locLo       = input.float(0.35, "Close location bearish if <=", minval=0, maxval=0.5, step=0.05, group=G5)
i_waitBars    = input.int(1, "Bars to wait after the first candle before any entry", minval=1, maxval=6, group=G5,
     tooltip="1 = the second 5-minute candle must close and validate the first one. The first candle itself never triggers an entry.")

G6 = "06 SMC / liquidity (confirmed pivots only)"
i_pivL     = input.int(3, "Pivot left bars", minval=1, maxval=10, group=G6)
i_pivR     = input.int(3, "Pivot right bars (= confirmation delay)", minval=1, maxval=10, group=G6)
i_evFresh  = input.int(12, "Structure / sweep evidence stays valid for N bars", minval=2, maxval=60, group=G6)
i_fbBars   = input.int(6, "Failed breakout/breakdown window (bars)", minval=1, maxval=30, group=G6)
i_retestBars = input.int(8, "Retest window (bars)", minval=1, maxval=40, group=G6)
i_retestTol  = input.float(0.25, "Retest tolerance (x ATR)", minval=0.05, step=0.05, group=G6)
i_dispAtr    = input.float(1.2, "Displacement: range >= x ATR", minval=0.5, step=0.1, group=G6)
i_dispBody   = input.float(0.6, "Displacement: body / range >=", minval=0.3, maxval=1, step=0.05, group=G6)
i_showFvg    = input.bool(true, "Draw recent unmitigated FVG boxes", group=G6)

G7 = "07 Seller-stress rules (symmetrical)"
i_reqReject = input.bool(true, "Require failed reclaim / rejection at the broken zone", group=G7)
i_reqStruct = input.bool(true, "Require BOS/CHoCH or displacement in the break direction", group=G7)
i_trig      = input.string("Stress or gap scenario", "Entry trigger", options=["Stress only", "Gap scenario only", "Stress or gap scenario"], group=G7,
     tooltip="Stress: potential seller-stress pattern at a broken zone. Gap scenario: validated gap continuation/reversal/flat-open breakout plus structure in the same direction.")
i_rejBars   = input.int(8, "Rejection / reclaim window (bars)", minval=1, maxval=40, group=G7)
i_emaF      = input.int(9, "Momentum EMA fast", minval=2, group=G7)
i_emaS      = input.int(21, "Momentum EMA slow", minval=3, group=G7)
i_rsiLen    = input.int(14, "RSI length", minval=2, group=G7)

G8 = "08 Candle/volume proxy (original transparent proxy - NOT a copy of any proprietary indicator)"
i_rvThr    = input.float(1.5, "Relative volume >=", minval=1, step=0.1, group=G8)
i_rngAtr   = input.float(1.3, "Range >= x ATR", minval=0.5, step=0.1, group=G8)
i_bodyThr  = input.float(0.6, "Body / range >=", minval=0.3, maxval=1, step=0.05, group=G8)
i_proxyMin = input.int(4, "Conditions required (of 6)", minval=1, maxval=6, group=G8)

G9 = "09 CE / PE premium (select the two option charts' symbols manually)"
i_ceSym  = input.symbol("", "CE contract symbol (e.g. NSE:NIFTY261027C24500)", group=G9, tooltip="Empty = OPTION DATA UNAVAILABLE. Pine cannot scan the chain or pick a contract for you.")
i_peSym  = input.symbol("", "PE contract symbol", group=G9)
i_prEmaF = input.int(9, "Premium EMA fast", minval=2, group=G9)
i_prEmaS = input.int(21, "Premium EMA slow", minval=3, group=G9)
i_prAtrM = input.float(1.0, "Premium stop distance (x premium ATR)", minval=0.2, step=0.1, group=G9)

G10 = "10 Evidence weights (signed evidence index, NOT a probability)"
w_htf    = input.float(2.0, "Weight: higher-timeframe agreement", minval=0, step=0.25, group=G10)
w_gap    = input.float(1.0, "Weight: gap scenario", minval=0, step=0.25, group=G10)
w_lvl    = input.float(1.5, "Weight: position vs previous-day / OI levels", minval=0, step=0.25, group=G10)
w_open   = input.float(1.5, "Weight: opening-candle confirmation", minval=0, step=0.25, group=G10)
w_struct = input.float(1.5, "Weight: BOS / CHoCH", minval=0, step=0.25, group=G10)
w_sweep  = input.float(1.0, "Weight: liquidity sweep / failed break", minval=0, step=0.25, group=G10)
w_volume = input.float(1.0, "Weight: volume confirmation (needs volume)", minval=0, step=0.25, group=G10)
w_mom    = input.float(1.0, "Weight: momentum (RSI)", minval=0, step=0.25, group=G10)
w_vwap   = input.float(1.0, "Weight: VWAP/TWAP side", minval=0, step=0.25, group=G10)
w_prem   = input.float(1.5, "Weight: option-premium confirmation (needs CE+PE)", minval=0, step=0.25, group=G10)
w_oi     = input.float(1.0, "Weight: actual OI/IV evidence (manual selector below)", minval=0, step=0.25, group=G10)
i_oiEvid = input.string("None", "Actual OI/IV evidence you have verified", options=["None", "Bullish", "Bearish"], group=G10,
     tooltip="Only set this if you have REAL option-chain OI/IV data pointing one way. 'None' disables the component. Rising OI alone is not treated as direction.")
i_entryThr = input.float(0.35, "Entry: |evidence index| >=", minval=0.05, maxval=1, step=0.05, group=G10)
i_minComp  = input.int(4, "Entry: minimum components with non-zero evidence", minval=1, maxval=11, group=G10)

G11 = "11 Entry / stop / targets / risk (index points; one position at a time, no averaging, no martingale)"
i_slBuf    = input.float(0.30, "Stop buffer beyond structure (x ATR)", minval=0, step=0.05, group=G11)
i_maxRisk  = input.float(3.0, "Reject setup if risk > x ATR", minval=0.5, step=0.1, group=G11)
i_rr1      = input.float(1.0, "Target 1 (R)", minval=0.2, step=0.1, group=G11)
i_rr2      = input.float(2.0, "Target 2 (R)", minval=0.4, step=0.1, group=G11)
i_rr3      = input.float(3.0, "Target 3 (R)", minval=0.6, step=0.1, group=G11)
i_q1       = input.float(40, "Exit % at T1", minval=0, maxval=100, group=G11)
i_q2       = input.float(30, "Exit % at T2", minval=0, maxval=100, group=G11, tooltip="T3 gets the rest. Use a quantity divisible by 10 so partial exits are whole units.")
i_minRR    = input.float(1.0, "Minimum distance to nearest opposing level (R)", minval=0, step=0.1, group=G11,
     tooltip="If the nearest opposing level (zone / previous-day extreme) is closer than this many R, the setup is skipped.")
i_trailBE  = input.bool(true, "After T1 move stop to entry; after T2 to T1", group=G11)
i_sizeMode = input.string("Fixed quantity", "Position sizing", options=["Fixed quantity", "Risk amount per trade"], group=G11)
i_qty      = input.float(10, "Fixed quantity (index units; use multiples of 10)", minval=1, group=G11)
i_riskAmt  = input.float(5000, "Risk amount per trade (account currency; qty = amount / risk points, floored to 10s)", minval=1, group=G11)
i_flipExit = input.bool(true, "Exit if opposite evidence confirms (opposite CHoCH or opposite index beyond threshold)", group=G11)
i_maxTrades = input.int(2, "Max trades per session", minval=1, maxval=10, group=G11)
i_maxLoss   = input.float(1500, "Max session loss (account currency; realised + open P&L; halts and flattens)", minval=1, group=G11)
i_cooldown  = input.int(6, "Cooldown after a loss (bars)", minval=0, maxval=100, group=G11)
i_noEarly   = input.bool(true, "No entries before the opening-wait window ends", group=G11)
i_lateCut   = input.string("1445", "No new entries from (HHMM, exchange time)", group=G11)
i_squareOff = input.string("1515", "Flatten at (HHMM, exchange time)", group=G11)
i_spikeAtr  = input.float(3.0, "No-trade if a bar's range > x ATR (abnormal volatility)", minval=1.5, step=0.1, group=G11)
i_blockExc  = input.bool(true, "No-trade on EXCEPTIONAL gap sessions", group=G11)

G12 = "12 Probability tracker (running, in-sample, expanding window)"
i_minSamples = input.int(50, "Minimum resolved virtual signals per side before any empirical rate is shown", minval=10, group=G12)
i_probHorizon = input.int(24, "Outcome horizon (bars): target 1 before stop within N bars", minval=3, group=G12)

G14 = "14 Entry timing - lower-timeframe (e.g. 3-minute) refinement"
i_refine  = input.string("Off", "Entry refinement mode", options=["Off", "Micro-breakout", "Pullback then resume"], group=G14,
     tooltip="Needs a chart BELOW 5 minutes (3-minute recommended). The 5-minute engine still decides the bias (it is read from the last COMPLETED 5-minute bar); the entry then waits for a lower-timeframe trigger. Off = enter at the next bar open after the 5-minute signal. On a 5-minute chart this setting has no effect.")
i_hostMode = input.string("Auto", "Chart timeframe handling (leave on Auto)", options=["Auto", "5-minute chart", "Chart below 5 minutes"], group=G14,
     tooltip="Auto reads the chart timeframe with timeframe.main_period. If a platform reports it wrongly the timing guard (dashboard: ENGINE TIMING MISMATCH) blocks all entries; then force the correct choice here.")
i_refWin  = input.int(4, "Bars to wait for the trigger (chart bars)", minval=1, maxval=20, group=G14, tooltip="Armed setups that are not confirmed within this many chart bars (or break the stop, or are contradicted by the next 5-minute signal) are dropped - never chased.")

G13 = "13 Dashboard"
i_dashOn   = input.bool(true, "Show dashboard", group=G13)
i_dashPos  = input.string("Top right", "Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=G13)
i_dashSize = input.string("Small", "Text size", options=["Tiny", "Small", "Normal", "Large"], group=G13)
i_compact  = input.bool(false, "Compact mode (fewer rows - good for mobile)", group=G13)
i_cBull    = input.color(#26a69a, "Bullish text", group=G13)
i_cBear    = input.color(#ef5350, "Bearish text", group=G13)
i_cNeu     = input.color(#b0b6c2, "Neutral text", group=G13)
i_cHead    = input.color(#ffffff, "Header text", group=G13)
i_cGen     = input.color(#d1d4dc, "General text", group=G13)
i_cBg      = input.color(#131722, "Background", group=G13)
i_bgTransp = input.int(15, "Background transparency", minval=0, maxval=100, group=G13)
i_cBorder  = input.color(#434651, "Border", group=G13)
i_borderW  = input.int(1, "Border width", minval=0, maxval=4, group=G13)
i_showStats = input.bool(true, "Show backtest statistics panel (bottom left)", group=G13)
i_showLvls  = input.bool(true, "Plot previous-day levels, opening range and OI zones", group=G13)
i_showLbl   = input.bool(true, "Chart labels for events", group=G13)
i_oosDate   = input.time(timestamp("1 Jan 2026 00:00 +0000"), "Out-of-sample split date for the statistics panel", group=G13)

// ───────────────────────────────────────────────── 02 HELPERS ────────────────────────────────────────────────────
f_ratio(a, b) => b > 0 ? a / b : 0.0
f_sgn(x) => x > 0 ? 1 : x < 0 ? -1 : 0
f_hhmm(s) =>
    float v = str.tonumber(s)
    float hh = math.floor(v / 100)
    hh * 60 + (v - hh * 100)
f_dowNum(s) => s == "Monday" ? dayofweek.monday : s == "Tuesday" ? dayofweek.tuesday : s == "Wednesday" ? dayofweek.wednesday : s == "Thursday" ? dayofweek.thursday : s == "Friday" ? dayofweek.friday : -1
f_vote(f, s, c) => na(f) or na(s) or na(c) ? 0 : (f > s and c > s ? 1 : f < s and c < s ? -1 : 0)
f_htf() => [ta.ema(close, i_htfFast)[1], ta.ema(close, i_htfSlow)[1], close[1]]
// Wilson 95% interval for a proportion
f_wilson(k, n) =>
    float p = n > 0 ? k / n : 0.0
    float z = 1.96
    float den = 1 + z * z / n
    float ctr = (p + z * z / (2 * n)) / den
    float half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    [ctr - half, ctr + half]
f_pos(s) =>
    switch s
        "Top left" => position.top_left
        "Top center" => position.top_center
        "Top right" => position.top_right
        "Middle left" => position.middle_left
        "Middle center" => position.middle_center
        "Middle right" => position.middle_right
        "Bottom left" => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
f_size(s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal

// the pivot helpers live here (global scope) so the analysis engine function can use them
f_pivH(int L, int R) =>
    float c = high[R]
    bool ok = not na(c)
    for k = 1 to L
        ok := ok and not na(high[R + k]) and c > high[R + k]
    for k = 0 to R - 1
        ok := ok and c >= high[k]
    ok ? c : na
f_pivL(int L, int R) =>
    float c = low[R]
    bool ok = not na(c)
    for k = 1 to L
        ok := ok and not na(low[R + k]) and c < low[R + k]
    for k = 0 to R - 1
        ok := ok and c <= low[k]
    ok ? c : na
// Pine has no bit operators: bit k of a non-negative integer packed as a float
f_bit(v, int k) => not na(v) and math.floor(v / math.pow(2, k)) % 2 == 1
f_scnText(int c) =>
    switch c
        1 => "GAP-DOWN CONTINUATION (provisional)"
        2 => "GAP-DOWN REVERSAL (provisional)"
        3 => "GAP-UP CONTINUATION (provisional)"
        4 => "GAP-UP REVERSAL (provisional)"
        5 => "FLAT OPEN (await opening-range breakout)"
        6 => "NO TRADE (gap-down, conflicting first candle)"
        7 => "NO TRADE (gap-up, conflicting first candle)"
        8 => "NO TRADE (gap context unavailable)"
        11 => "GAP-DOWN CONTINUATION (validated by 2nd candle)"
        12 => "GAP-DOWN REVERSAL (validated by 2nd candle)"
        13 => "GAP-UP CONTINUATION (validated by 2nd candle)"
        14 => "GAP-UP REVERSAL (validated by 2nd candle)"
        15 => "FLAT-OPEN BREAKOUT UP"
        16 => "FLAT-OPEN BREAKOUT DOWN"
        17 => "NO TRADE (2nd candle did not validate the scenario)"
        18 => "NO TRADE (opening-range breakout failed)"
        => "NO TRADE (no context yet)"
f_gapName(int c) =>
    switch c
        0 => "FLAT"
        1 => "GAP UP"
        -1 => "GAP DOWN"
        2 => "EXCEPTIONAL UP"
        -2 => "EXCEPTIONAL DOWN"
        9 => "UNKNOWN (ATR warm-up)"
        => "N/A"
f_openStatus(int c) =>
    switch c
        1 => "VALIDATED BULL"
        2 => "VALIDATED BEAR"
        3 => "INVALIDATED"
        4 => "UNVALIDATED"
        5 => "NO DIRECTIONAL FIRST CANDLE"
        => "PENDING"
f_openVs(int c) => c == 1 ? "ABOVE" : c == 2 ? "INSIDE" : c == 3 ? "BELOW" : "n/a"
