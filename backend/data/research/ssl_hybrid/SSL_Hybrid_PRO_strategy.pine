//@version=6
// =====================================================================
// SSL Hybrid PRO - Universal Index  ::  STRATEGY-TESTER conversion
// =====================================================================
// Same signal logic as the indicator, byte-for-byte. The ONLY additions
// are strategy.* order calls so TradingView's Strategy Tester computes a
// real win rate / P&L instead of you reading it off chart labels.
//
// Anti-repaint: calc_on_every_tick = false + process_orders_on_close =
// false -> historical signals evaluate on CLOSED bars only, exactly like
// a backtest. Turn on "Bar Magnifier" in Strategy Properties for honest
// intrabar SL/TP fills, and keep the commission + slippage below.
//
// If the tester still shows a high win rate, it is real. If (as expected)
// it lands ~40-55%, that is the true number and the "99%" was repainting
// + max_labels_count + hindsight on the indicator.
// =====================================================================

strategy("SSL Hybrid PRO - STRATEGY", overlay = true, max_labels_count = 500,
     initial_capital        = 100000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value       = 100,
     pyramiding             = 0,
     calc_on_every_tick     = false,
     process_orders_on_close = false,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.03,
     slippage               = 2)

// =====================================================
// INPUTS  (identical to the indicator)
// =====================================================
ssl1Len      = input.int(60,  "SSL1 Length", minval = 1)
ssl2Len      = input.int(5,   "SSL2 Fast Length", minval = 1)
exitLen      = input.int(15,  "Exit Length", minval = 1)
baselineLen  = input.int(60,  "Baseline Length", minval = 1)
emaLen       = input.int(200, "EMA Trend Length", minval = 1)
hmaLen       = input.int(55,  "HMA Length", minval = 1)
rsiLen       = input.int(14,  "RSI Length", minval = 1)
adxLen       = input.int(14,  "ADX Length", minval = 1)
adxMin       = input.float(20.0, "Minimum ADX", step = 0.5)
volLen       = input.int(20,  "Volume Average Length", minval = 1)
volMult      = input.float(1.0, "Volume Multiplier", step = 0.1)
atrLen       = input.int(14,  "ATR Length", minval = 1)
atrMult      = input.float(1.5, "ATR Stop Multiplier", step = 0.1)
rr1          = input.float(1.0, "Target 1 RR", step = 0.1)
rr2          = input.float(2.0, "Target 2 RR", step = 0.1)
rr3          = input.float(3.0, "Target 3 RR", step = 0.1)
minConfidence = input.int(70, "Minimum Confidence", minval = 1, maxval = 100)

// --- strategy-only wiring (does NOT touch the signal) ---
grpX          = "Trade management (tester only)"
exitMode      = input.string("Scale 1/3 at T1-T2-T3", "Exit style", options = ["Scale 1/3 at T1-T2-T3", "All at T1", "All at T3"], group = grpX)
useBreakEven  = input.bool(true,  "Move SL to break-even after first partial", group = grpX)
closeOnOpp    = input.bool(true,  "Close on opposite signal", group = grpX)
flattenEOD    = input.bool(true,  "Flatten at session end", group = grpX)
eodHour       = input.int(15, "  session-end hour",   minval = 0, maxval = 23, group = grpX)
eodMin        = input.int(15, "  session-end minute", minval = 0, maxval = 59, group = grpX)
useDateFilter = input.bool(false, "Limit backtest window", group = grpX)
fromDate      = input.time(timestamp("2016-01-01 00:00"), "  from", group = grpX)
toDate        = input.time(timestamp("2026-01-01 00:00"), "  to",   group = grpX)

// Display toggles (kept for parity)
showSSL       = input.bool(true, "Show SSL")
showBaseline  = input.bool(true, "Show 60 Baseline")
showEMA       = input.bool(true, "Show EMA 200")
showVWAP      = input.bool(true, "Show VWAP")
showHMA       = input.bool(true, "Show HMA")
showTargets   = input.bool(true, "Show Targets")
showDashboard = input.bool(true, "Show Dashboard")

// =====================================================
// ===== SIGNAL BLOCK -- copied verbatim from the indicator =====
// =====================================================

// ---------- SSL 1 ----------
ssl1High = ta.ema(high, ssl1Len)
ssl1Low  = ta.ema(low,  ssl1Len)
var int ssl1State = 0
ssl1State := close > ssl1High ? 1 : close < ssl1Low ? -1 : ssl1State[1]
ssl1Up   = ssl1State < 0 ? ssl1Low  : ssl1High
ssl1Down = ssl1State < 0 ? ssl1High : ssl1Low

// ---------- SSL 2 ----------
ssl2High = ta.ema(high, ssl2Len)
ssl2Low  = ta.ema(low,  ssl2Len)
var int ssl2State = 0
ssl2State := close > ssl2High ? 1 : close < ssl2Low ? -1 : ssl2State[1]
ssl2Up   = ssl2State < 0 ? ssl2Low  : ssl2High
ssl2Down = ssl2State < 0 ? ssl2High : ssl2Low

// ---------- EXIT CHANNEL ----------
exitHigh = ta.ema(high, exitLen)
exitLow  = ta.ema(low,  exitLen)
var int exitState = 0
exitState := close > exitHigh ? 1 : close < exitLow ? -1 : exitState[1]
exitUp   = exitState < 0 ? exitLow  : exitHigh
exitDown = exitState < 0 ? exitHigh : exitLow

// ---------- filters ----------
baseline  = ta.ema(close, baselineLen)
ema200    = ta.ema(close, emaLen)
vwapValue = ta.vwap(hlc3)
hma       = ta.hma(close, hmaLen)
hmaBull   = hma > hma[1]
hmaBear   = hma < hma[1]
rsi       = ta.rsi(close, rsiLen)
rsiBull   = rsi > 55
rsiBear   = rsi < 45
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
adxBull   = adx >= adxMin and diPlus  > diMinus
adxBear   = adx >= adxMin and diMinus > diPlus
avgVolume = ta.sma(volume, volLen)
volumeOK  = volume >= avgVolume * volMult

// ---------- candle strength ----------
candleRange = high - low
bodySize    = math.abs(close - open)
bodyPercent = candleRange > 0 ? bodySize / candleRange * 100 : 0
bullCandle  = close > open and bodyPercent >= 50
bearCandle  = close < open and bodyPercent >= 50

// ---------- price location ----------
aboveVWAP     = close > vwapValue
belowVWAP     = close < vwapValue
aboveBaseline = close > baseline
belowBaseline = close < baseline
aboveEMA      = close > ema200
belowEMA      = close < ema200

// ---------- SSL direction ----------
sslBull       = ssl1Up > ssl1Down and ssl2Up > ssl2Down
sslBear       = ssl1Up < ssl1Down and ssl2Up < ssl2Down
sslCrossBull  = ta.crossover(ssl1Up, ssl1Down)
sslCrossBear  = ta.crossunder(ssl1Up, ssl1Down)

// ---------- raw score (max 110) ----------
int bullRaw = 0
int bearRaw = 0
bullRaw += sslBull ? 20 : 0
bearRaw += sslBear ? 20 : 0
bullRaw += sslCrossBull ? 10 : 0
bearRaw += sslCrossBear ? 10 : 0
bullRaw += aboveBaseline ? 10 : 0
bearRaw += belowBaseline ? 10 : 0
bullRaw += aboveEMA ? 10 : 0
bearRaw += belowEMA ? 10 : 0
bullRaw += aboveVWAP ? 10 : 0
bearRaw += belowVWAP ? 10 : 0
bullRaw += hmaBull ? 10 : 0
bearRaw += hmaBear ? 10 : 0
bullRaw += rsiBull ? 10 : 0
bearRaw += rsiBear ? 10 : 0
bullRaw += adxBull ? 10 : 0
bearRaw += adxBear ? 10 : 0
bullRaw += volumeOK and close > open ? 5 : 0
bearRaw += volumeOK and close < open ? 5 : 0
bullRaw += bullCandle ? 5 : 0
bearRaw += bearCandle ? 5 : 0

bullScore = math.round(bullRaw * 100.0 / 110.0)
bearScore = math.round(bearRaw * 100.0 / 110.0)

// ---------- high-confidence conditions ----------
strongBull = bullScore >= minConfidence and sslBull and aboveBaseline and aboveVWAP and adxBull
strongBear = bearScore >= minConfidence and sslBear and belowBaseline and belowVWAP and adxBear

buySignal  = strongBull and not strongBull[1]
sellSignal = strongBear and not strongBear[1]

// ---------- ATR risk engine (verbatim) ----------
atr = ta.atr(atrLen)

buyEntry = close
buySL    = buyEntry - atr * atrMult
buyRisk  = buyEntry - buySL
buyT1    = buyEntry + buyRisk * rr1
buyT2    = buyEntry + buyRisk * rr2
buyT3    = buyEntry + buyRisk * rr3

sellEntry = close
sellSL    = sellEntry + atr * atrMult
sellRisk  = sellSL - sellEntry
sellT1    = sellEntry - sellRisk * rr1
sellT2    = sellEntry - sellRisk * rr2
sellT3    = sellEntry - sellRisk * rr3

// =====================================================
// ===== STRATEGY WIRING (new) =====
// =====================================================
inWindow = not useDateFilter or (time >= fromDate and time <= toDate)

// remember the levels that were live at entry time
var float eEntry = na
var float eSL    = na
var float eT1    = na
var float eT2    = na
var float eT3    = na
var int   eDir   = 0
var float eInitSize = na
var bool  ePartial  = false

// ---- entries ----
if inWindow and buySignal and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
    eEntry := buyEntry, eSL := buySL, eT1 := buyT1, eT2 := buyT2, eT3 := buyT3
    eDir := 1, eInitSize := na, ePartial := false

if inWindow and sellSignal and strategy.position_size >= 0
    strategy.entry("S", strategy.short)
    eEntry := sellEntry, eSL := sellSL, eT1 := sellT1, eT2 := sellT2, eT3 := sellT3
    eDir := -1, eInitSize := na, ePartial := false

// capture the filled size on the bar the position opens
if eDir != 0 and na(eInitSize) and strategy.position_size != 0
    eInitSize := math.abs(strategy.position_size)

// detect a partial fill -> optionally ratchet SL to break-even
if eDir != 0 and not na(eInitSize) and math.abs(strategy.position_size) < eInitSize and strategy.position_size != 0
    ePartial := true
curStop = (useBreakEven and ePartial) ? eEntry : eSL

// ---- managed exits ----
if strategy.position_size > 0 and eDir == 1
    if exitMode == "All at T1"
        strategy.exit("L-x", from_entry = "L", stop = curStop, limit = eT1)
    else if exitMode == "All at T3"
        strategy.exit("L-x", from_entry = "L", stop = curStop, limit = eT3)
    else
        strategy.exit("L-1", from_entry = "L", qty_percent = 33.34, stop = curStop, limit = eT1)
        strategy.exit("L-2", from_entry = "L", qty_percent = 33.34, stop = curStop, limit = eT2)
        strategy.exit("L-3", from_entry = "L", stop = curStop, limit = eT3)

if strategy.position_size < 0 and eDir == -1
    if exitMode == "All at T1"
        strategy.exit("S-x", from_entry = "S", stop = curStop, limit = eT1)
    else if exitMode == "All at T3"
        strategy.exit("S-x", from_entry = "S", stop = curStop, limit = eT3)
    else
        strategy.exit("S-1", from_entry = "S", qty_percent = 33.34, stop = curStop, limit = eT1)
        strategy.exit("S-2", from_entry = "S", qty_percent = 33.34, stop = curStop, limit = eT2)
        strategy.exit("S-3", from_entry = "S", stop = curStop, limit = eT3)

// ---- discretionary closes ----
if closeOnOpp and strategy.position_size > 0 and sellSignal
    strategy.close("L", comment = "opp")
if closeOnOpp and strategy.position_size < 0 and buySignal
    strategy.close("S", comment = "opp")

isEOD = (hour * 60 + minute) >= (eodHour * 60 + eodMin)
if flattenEOD and isEOD and strategy.position_size != 0
    strategy.close_all(comment = "eod")

if strategy.position_size == 0
    eDir := 0

// =====================================================
// PLOTS  (visual parity -- do not affect the tester)
// =====================================================
plot(showSSL ? ssl1Up   : na, "SSL1 Up",   color = color.lime,   linewidth = 2)
plot(showSSL ? ssl1Down : na, "SSL1 Down", color = color.red,    linewidth = 2)
plot(showSSL ? ssl2Up   : na, "SSL2 Up",   color = color.aqua,   linewidth = 1)
plot(showSSL ? ssl2Down : na, "SSL2 Down", color = color.orange, linewidth = 1)
plot(showBaseline ? baseline  : na, "60 Baseline", color = color.yellow, linewidth = 2)
plot(showEMA      ? ema200    : na, "EMA 200",     color = color.blue,   linewidth = 2)
plot(showVWAP     ? vwapValue : na, "VWAP",        color = color.white,  linewidth = 2)
plot(showHMA      ? hma       : na, "HMA",         color = color.purple, linewidth = 2)

plotshape(buySignal,  "BUY",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(sellSignal, "SELL", shape.triangledown, location.abovebar, color.red,   size = size.small)

if buySignal
    label.new(bar_index, low,
         "BUY\nConfidence: " + str.tostring(bullScore) + "/100\n" +
         "Entry: " + str.tostring(buyEntry, format.mintick) + "\n" +
         "SL: "  + str.tostring(buySL, format.mintick) + "\n" +
         "T1: "  + str.tostring(buyT1, format.mintick) + "\n" +
         "T2: "  + str.tostring(buyT2, format.mintick) + "\n" +
         "T3: "  + str.tostring(buyT3, format.mintick),
         style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if sellSignal
    label.new(bar_index, high,
         "SELL\nConfidence: " + str.tostring(bearScore) + "/100\n" +
         "Entry: " + str.tostring(sellEntry, format.mintick) + "\n" +
         "SL: "  + str.tostring(sellSL, format.mintick) + "\n" +
         "T1: "  + str.tostring(sellT1, format.mintick) + "\n" +
         "T2: "  + str.tostring(sellT2, format.mintick) + "\n" +
         "T3: "  + str.tostring(sellT3, format.mintick),
         style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

plot(showTargets and strategy.position_size != 0 ? eEntry : na, "Entry", color = color.white, style = plot.style_linebr)
plot(showTargets and strategy.position_size != 0 ? curStop : na, "Stop", color = color.red,   style = plot.style_linebr, linewidth = 2)
plot(showTargets and strategy.position_size != 0 ? eT1    : na, "T1",   color = color.green, style = plot.style_linebr)
plot(showTargets and strategy.position_size != 0 ? eT2    : na, "T2",   color = color.green, style = plot.style_linebr)
plot(showTargets and strategy.position_size != 0 ? eT3    : na, "T3",   color = color.green, style = plot.style_linebr)

bgcolor(strongBull ? color.new(color.green, 92) : strongBear ? color.new(color.red, 92) : na)

// =====================================================
// DASHBOARD
// =====================================================
var table dash = table.new(position.top_right, 2, 12)
if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "SSL HYBRID PRO"), table.cell(dash, 1, 0, "STRATEGY")
    table.cell(dash, 0, 1, "SSL"),          table.cell(dash, 1, 1, sslBull ? "BULLISH" : sslBear ? "BEARISH" : "NEUTRAL")
    table.cell(dash, 0, 2, "60 Baseline"),  table.cell(dash, 1, 2, aboveBaseline ? "BULL" : "BEAR")
    table.cell(dash, 0, 3, "VWAP"),         table.cell(dash, 1, 3, aboveVWAP ? "BULL" : "BEAR")
    table.cell(dash, 0, 4, "EMA 200"),      table.cell(dash, 1, 4, aboveEMA ? "BULL" : "BEAR")
    table.cell(dash, 0, 5, "RSI"),          table.cell(dash, 1, 5, str.tostring(rsi, "#.0"))
    table.cell(dash, 0, 6, "ADX"),          table.cell(dash, 1, 6, str.tostring(adx, "#.0"))
    table.cell(dash, 0, 7, "Volume"),       table.cell(dash, 1, 7, volumeOK ? "OK" : "WEAK")
    table.cell(dash, 0, 8, "BUY Score"),    table.cell(dash, 1, 8, str.tostring(bullScore) + "/100")
    table.cell(dash, 0, 9, "SELL Score"),   table.cell(dash, 1, 9, str.tostring(bearScore) + "/100")
    table.cell(dash, 0, 10, "Position"),    table.cell(dash, 1, 10, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT")
    table.cell(dash, 0, 11, "Net Profit"),  table.cell(dash, 1, 11, str.tostring(strategy.netprofit, "#.0"))

// =====================================================
// ALERTS
// =====================================================
alertcondition(buySignal,  "SSL PRO BUY",  "SSL Hybrid PRO BUY signal")
alertcondition(sellSignal, "SSL PRO SELL", "SSL Hybrid PRO SELL signal")
