    },
    "never_rewrite_past_signals": true
  },
  "scoring": {
    "components_max": {
      "structure": 2,
      "liquidity_sweep": 2,
      "delta_cvd": 2,
      "imbalance_absorption": 2,
      "vwap_regime": 1,
      "relative_volume": 1,
      "htf_alignment": 1
