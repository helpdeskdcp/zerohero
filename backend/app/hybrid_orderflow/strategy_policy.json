    "min_total_score": 7,
    "min_distinct_evidence_groups": 3,
    "conflict_rule": "WAIT_IF_ANY_OPPOSING",
    "is_probability": false,
    "status": "INITIAL_UNCALIBRATED",
    "mandatory_components": [
      "structure"
    ],
    "groups": {
      "STRUCTURE": [
        "structure"
      ],
      "LIQUIDITY": [
        "liquidity_sweep"
      ],
      "ORDERFLOW": [
