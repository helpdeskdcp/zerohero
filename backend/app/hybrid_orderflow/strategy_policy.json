      "stack_min_run": 3,
      "stack_ratio": 3.0,
      "min_level_volume": 10,
      "require_tick_size": true,
      "status": "INITIAL"
    },
    "absorption": {
      "status": "REQUIRES_DATA",
      "_note": "needs tick volume + book events; treated as inference not proof"
    },
    "dom": {
      "max_book_age_sec": 3.0,
      "reject_crossed_book": true
    },
    "volume_profile": {
      "label_ohlcv_approximation": true
    }
  },
  "smc": {
    "pivot_len": 3,
    "pivot_confirmation": "CLOSED_CANDLES_RIGHT_SIDE",
    "bos_requires": "CANDLE_CLOSE_BEYOND_LEVEL",
    "choch_requires": "CANDLE_CLOSE_BEYOND_LEVEL",
    "sweep": {
